{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignore": [
      "**/backend.ts",
      "**/backend.d.ts",
      "dist/**",
      "node_modules/**",
      "build/**",
      "*.config.js",
      "src/declarations/**",
      "src/config.ts",
      "src/components/ConstitutionalShader.tsx",
      "src/components/CrossChainBridgePanel.tsx",
      "src/components/CymaticAudioShader.tsx",
      "src/components/FullStackController.tsx",
      "src/components/HumanShader.tsx",
      "src/components/MerkabahSolarShader.tsx",
      "src/components/ObservabilityDashboard.tsx",
      "src/components/TVBroadcastPanel.tsx",
      "src/components/ProposalCard.tsx",
      "src/components/VotingPanel.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useHookAtTopLevel": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "useConst": "off",
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
